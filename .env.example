# ---------- LLM ----------
# Renseigne au moins une clé. Les fournisseurs, leur ordre et les modèles se règlent ensuite
# dans l'interface (page Modèles). Laisser une clé vide désactive le fournisseur.
# gratuit : https://console.groq.com/keys
GROQ_API_KEY=
# gratuit : https://aistudio.google.com/apikey
GEMINI_API_KEY=
# offre gratuite : https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
# modèles :free : https://openrouter.ai/keys
OPENROUTER_API_KEY=
# payant : https://platform.openai.com/api-keys
OPENAI_API_KEY=
# payant : https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://ollama:11434

# Valeurs initiales (modifiables ensuite dans la page Modèles)
# groq, gemini, mistral, openrouter, openai, anthropic, ollama
LLM_PROVIDER=groq
# fixe, intelligent, performance
LLM_ROUTING=intelligent
LLM_TIMEOUT_S=90

# ---------- Général ----------
TIMEZONE=Indian/Antananarivo

# ---------- Garde-fous et budgets ----------
MIN_INTERVAL_HOURS=6
MAX_QUERIES_PER_ROUND=6
MAX_ROUNDS=2
MAX_PAGES_PER_RUN=15
TOKEN_BUDGET_PER_RUN=60000
DOMAIN_DELAY_SECONDS=2

# ---------- Cache ----------
PAGE_CACHE_DAYS=7
SEARCH_CACHE_HOURS=6
SEMANTIC_CACHE_THRESHOLD=0.92

# ---------- Notifications Telegram (optionnel) ----------
# 1. Crée un bot avec @BotFather  2. Envoie-lui un message  3. Récupère ton chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
